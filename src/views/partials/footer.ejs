</main>
<% const c = concesionaria; %>

<%# ═════════ Pie ═════════ %>
<footer class="footer" id="contacto">
  <div class="contenedor">
    <div class="footer__arriba">
      <div class="footer__marca">
        <a href="/" class="marca-link" aria-label="Inicio"><%- include('logo') %></a>
        <p><a href="<%= c.mapa %>" target="_blank" rel="noopener"><%= c.direccion %></a> &bull; <%= c.horarios %></p>
      </div>
      <div class="footer__botones">
        <a href="<%= c.instagram %>" target="_blank" rel="noopener noreferrer" class="btn btn--oscuro"><%- icono('instagram', 'icono--rojo') %>Instagram</a>
        <button type="button" class="btn btn--rojo" data-asesor="Consulta General desde Contacto"><%- icono('message-circle') %>Consultar con asesor</button>
      </div>
    </div>
    <div class="footer__abajo">
      <p>&copy; <%= new Date().getFullYear() %> <%= c.nombre %>. Todos los derechos reservados.</p>
      <p><%= c.ciudad %></p>
    </div>
  </div>
</footer>

<%# Botón flotante de WhatsApp %>
<a href="<%= c.whatsapp() %>" class="whatsapp-flotante" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.4A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7 3.9Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
</a>

<%- include('modal-asesor') %>

<script src="/js/base.js"></script>
<% if (locals.script) { %><script src="/js/<%= script %>.js"></script><% } %>
</body>
</html>
