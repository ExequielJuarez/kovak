<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> | Kovak Automotores</title>
  <meta name="description" content="<%= locals.descripcion || 'Kovak Automotores: concesionaria en San Miguel de Tucumán. Usados seleccionados y 0km multimarca con garantía mecánica y transferencia inmediata.' %>">
  <meta name="theme-color" content="#0B0B0C">
  <meta property="og:title" content="<%= titulo %> | Kovak Automotores">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= locals.imagenOg || '/img/portada/portada.jpg' %>">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:ital,wght@0,700;0,800;0,900;1,800&display=swap" rel="stylesheet">

  <%# Si una foto no existe, se muestra la imagen neutra de "sin foto" %>
  <script>document.addEventListener('error', function (e) { var i = e.target; if (i.tagName === 'IMG' && !i.dataset.sinFoto) { i.dataset.sinFoto = '1'; i.src = '/img/sin-foto.svg'; } }, true);</script>

  <link rel="stylesheet" href="/css/base.css">
  <%# estilo puede ser un nombre o una lista: "inicio" o ["vehiculos", "otra"] %>
  <% [].concat(locals.estilo || []).forEach(hoja => { %>
    <link rel="stylesheet" href="/css/<%= hoja %>.css">
  <% }) %>
</head>
<body>
