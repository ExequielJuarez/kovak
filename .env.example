# Copiá este archivo como .env y completá los valores.

# ── Servidor ────────────────────────────────────────────────
# En el servidor publicado poné NODE_ENV=production. En tu compu dejalo vacío.
NODE_ENV=
PORT=3000
# HOST=127.0.0.1 deja la web solo para esta compu (sacalo para abrirla desde el celular)
# HOST=0.0.0.0

# ── Sesión del panel ────────────────────────────────────────
# Frase larga y secreta para firmar la cookie de sesión
SESSION_SECRET=

# ── Usuario del panel (/admin) ──────────────────────────────
# Lo crea `npm run db:instalar` (o lo actualiza `npm run db:admin`). La clave: mínimo 8 caracteres.
ADMIN_NOMBRE=Administrador
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

# ── Base de datos MySQL ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kovak_automotores
# DB_LOG=true muestra en consola cada consulta SQL
